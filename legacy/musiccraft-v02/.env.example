# Default: no paid calls and no GPU required.
MUSICCRAFT_MODE=demo
MUSICCRAFT_HOST=127.0.0.1
MUSICCRAFT_PORT=8765
MUSICCRAFT_WORKERS=2
MUSICCRAFT_ENABLE_COMPOSE=false
MUSICCRAFT_FFMPEG=ffmpeg

# rules = offline task extraction; llm = your provider's chat-completions endpoint.
MUSICCRAFT_PLANNER=rules
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Set MODE=live only after configuring the service you want to use.
ACESTEP_BASE_URL=
ACESTEP_API_KEY=
# Optional; blank uses the server's default model.
ACESTEP_MODEL=
ACESTEP_THINKING=false
MUSICCRAFT_PROVIDER_TIMEOUT=1800

# Project-defined interface; NOT the native Seed-VC API. See docs/INTEGRATIONS.md.
VOICE_WORKER_URL=
VOICE_WORKER_API_KEY=
VOICE_WORKER_PROTOCOL=async
